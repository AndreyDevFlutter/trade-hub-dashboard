{
  "manifest_version": 3,
  "name": "ActionBroker Sniffer",
  "version": "1.1.0",
  "description": "Captura requisições da API ActionBroker (fetch, XHR e webRequest)",
  "permissions": ["storage", "activeTab", "webRequest"],
  "host_permissions": ["https://*.actionbroker.app/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.actionbroker.app/*"],
      "js": ["patcher.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.actionbroker.app/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "ActionBroker Sniffer" },
  "icons": { "48": "icon.png", "128": "icon.png" }
}
